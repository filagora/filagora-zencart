{
    "name": "filagora/filagora-zencart",
    "description": "Zen Cart profile for Filagora: the extra columns, bindings, key remaps and seeders zen-cart.com needs on top of the generic packages.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "forum",
        "filagora",
        "zen-cart"
    ],
    "require": {
        "filagora/filagora-cms": "^0.3.1",
        "filagora/filagora-compliance": "^0.1",
        "filagora/filagora-core": "^0.2.2",
        "filagora/filagora-entitlements": "^0.2",
        "filagora/filagora-forums": "^0.6",
        "filagora/filagora-memberships": "^0.1.1",
        "filagora/filagora-messages": "^0.2",
        "php": "^8.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Filagora\\ZenCart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Filagora\\ZenCart\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Filagora\\ZenCart\\ZenCartServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
